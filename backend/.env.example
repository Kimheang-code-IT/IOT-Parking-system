# Local development (SQLite only)

DATABASE_URL=sqlite:///./data/iot_parking.db
# SEED_DEMO_DATA=true

# RFID access control
# Second scan of the same card at the same gate inside this window is answered
# with duplicate=true and logged (firmware has its own 8s scan gate too).
RFID_SCAN_COOLDOWN_SECONDS=8
# Optional shared secret for the card-management endpoints
# (GET/POST /api/rfid/cards, /api/rfid/scans, /api/rfid/gate-activity).
# Empty = open (local dev only). Set a value in production.
RFID_ADMIN_TOKEN=

# Gate command safety window: pending/delivered commands past this age are
# expired and never delivered. Keep aligned with the ESP32 firmware
# PARKING_COMMAND_VALIDITY_MS (default 180000 = 180 s).
GATE_COMMAND_TIMEOUT_SECONDS=180

# Thermal receipt files (dev: saved to disk instead of a real printer)
GATE_RECEIPT_DIR=data/receipts

CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000
RATE_LIMIT=120/minute
TOTAL_PARKING_SPOTS=200
RATE_PER_HOUR=2.00
MINIMUM_FEE=1.00
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret

IOT_ENTRY_DEVICE_TOKEN=secret-entry-token
IOT_EXIT_DEVICE_TOKEN=secret-exit-token

# Mock QR by default; set false + merchant/key for PayWay sandbox
ABA_PAY_USE_MOCK=true
ABA_PAY_API_URL=https://checkout-sandbox.payway.com.kh
ABA_PAY_MERCHANT_ID=
ABA_PAY_API_KEY=
ABA_PAY_CALLBACK_URL=http://localhost:8000/api/payment/webhook
ABA_PAY_CURRENCY=USD
ABA_PAY_PAYMENT_OPTION=abapay_khqr
ABA_PAY_QR_TEMPLATE=template3_color
ABA_PAY_QR_LIFETIME_MINUTES=30
