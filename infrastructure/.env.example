# =============================================================================
# Smart IoT Parking — infrastructure environment
#
# 1. Copy this file:            Copy-Item .env.example .env
# 2. Replace every CHANGE_ME value.
# 3. Generate strong secrets (PowerShell):
#      -join ((48..57) + (97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
#
# NEVER commit the real .env (it is git-ignored).
# =============================================================================

# --- Docker Compose -----------------------------------------------------------
COMPOSE_PROJECT_NAME=iot-parking
# External port for the nginx reverse proxy (the app entry point).
# 80 may conflict with IIS/other web servers on Windows -> use e.g. 8080.
HTTP_PORT=80

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=iot_parking
POSTGRES_USER=iot_parking
# Use a URL-safe password (letters/digits) or set DATABASE_URL explicitly below.
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# Compose overrides this to use the `db` service hostname; the value here is
# only read if you run the backend outside Docker against local PostgreSQL.
DATABASE_URL=postgresql+psycopg2://iot_parking:CHANGE_ME_postgres_password@db:5432/iot_parking

# --- Backend application ------------------------------------------------------
APP_ENV=production
# DEBUG for local development, INFO for the container stack
LOG_LEVEL=INFO
# Uvicorn worker processes (keep 1 unless you have measured a reason)
WEB_CONCURRENCY=1
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000
# Public base URL of this deployment (used e.g. for payment callback URLs).
# Use the Docker host LAN IP so devices/browsers on the network can reach it.
API_BASE_URL=http://192.168.1.100
RATE_LIMIT=120/minute
TOTAL_PARKING_SPOTS=200
RATE_PER_HOUR=2.00
MINIMUM_FEE=1.00

# JSON response size / demo data
SEED_DEMO_DATA=false

# --- Secrets ------------------------------------------------------------------
# Payment webhook signature secret (ABA / KHQR gateway).
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
# Exit barcode HMAC secret — defaults to PAYMENT_WEBHOOK_SECRET when empty.
EXIT_VERIFY_SECRET=
# Reserved for future session/JWT use (the current app has no staff login).
SECRET_KEY=CHANGE_ME_app_secret
# RFID card-management endpoints (register/block cards). Recommended non-empty.
RFID_ADMIN_TOKEN=CHANGE_ME_rfid_admin_token

# --- IoT devices --------------------------------------------------------------
# Must match iot/include/parking_secrets.h on the ESP32 gates.
IOT_ENTRY_DEVICE_TOKEN=CHANGE_ME_entry_device_token
IOT_EXIT_DEVICE_TOKEN=CHANGE_ME_exit_device_token
RFID_SCAN_COOLDOWN_SECONDS=8
# Stale gate approvals expire server-side (safety). Align with firmware
# PARKING_COMMAND_VALIDITY_MS (default 180000 ms = 180 s).
GATE_COMMAND_TIMEOUT_SECONDS=180
GATE_RECEIPT_DIR=data/receipts

# --- Payments (ABA KHQR) ------------------------------------------------------
# Live deployment: keep mock OFF and set real sandbox/production credentials.
# Classroom/demo mode: set true. Note: the backend automatically falls back to
# mock QR generation when merchant id/key are empty, even with mock OFF.
ABA_PAY_USE_MOCK=false
ABA_PAY_API_URL=https://checkout-sandbox.payway.com.kh
ABA_PAY_MERCHANT_ID=
ABA_PAY_API_KEY=
# Must be reachable by the payment provider (or by your browser in mock mode)
ABA_PAY_CALLBACK_URL=http://192.168.1.100/api/payment/webhook
ABA_PAY_CURRENCY=USD
ABA_PAY_PAYMENT_OPTION=abapay_khqr
ABA_PAY_QR_TEMPLATE=template3_color
ABA_PAY_QR_LIFETIME_MINUTES=30

# --- Frontend (Nuxt) ----------------------------------------------------------
# Same-origin through the nginx reverse proxy: "/" => browser calls /api/...
# Set to http://<lan-ip>:8000 only if you bypass the proxy.
NUXT_PUBLIC_API_URL=/
# Public site URL (used for absolute links)
NUXT_PUBLIC_SITE_URL=http://localhost

# --- Backups ------------------------------------------------------------------
# backup-db.ps1 writes here (created automatically, git-ignored)
BACKUP_DIR=backups
